{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.1.33",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "action": {
    "default_title": "__MSG_actionTitle__"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "host_permissions": [
    "https://github.com/*",
    "https://patch-diff.githubusercontent.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "src/version.js",
        "src/i18n.js",
        "src/debug.js",
        "src/xml.js",
        "src/model.js",
        "src/lines.js",
        "src/diff.js",
        "src/github.js",
        "src/ui.js",
        "src/inline.js",
        "src/content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
